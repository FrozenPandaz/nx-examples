{
  "version": 2,
  "projects": {
    "button2": {
      "root": "libs/button2",
      "sourceRoot": "libs/button2/src",
      "projectType": "library",
      "targets": {
        "lint": {
          "executor": "@nrwl/linter:eslint",
          "options": {
            "lintFilePatterns": ["libs/button2/**/*.{ts,tsx,js,jsx}"]
          }
        },
        "test": {
          "executor": "@nrwl/jest:jest",
          "outputs": ["coverage/libs/button2"],
          "options": {
            "jestConfig": "libs/button2/jest.config.js",
            "passWithNoTests": true
          }
        },
        "storybook": {
          "executor": "@nrwl/storybook:storybook",
          "options": {
            "uiFramework": "@storybook/react",
            "port": 4400,
            "config": {
              "configFolder": "libs/button2/.storybook"
            }
          },
          "configurations": {
            "ci": {
              "quiet": true
            }
          }
        },
        "build-storybook": {
          "executor": "@nrwl/storybook:build",
          "outputs": ["{options.outputPath}"],
          "options": {
            "uiFramework": "@storybook/react",
            "outputPath": "dist/storybook/button2",
            "config": {
              "configFolder": "libs/button2/.storybook"
            }
          },
          "configurations": {
            "ci": {
              "quiet": true
            }
          }
        }
      }
    },
    "button2-e2e": {
      "root": "apps/button2-e2e",
      "sourceRoot": "apps/button2-e2e/src",
      "projectType": "application",
      "targets": {
        "e2e": {
          "executor": "@nrwl/cypress:cypress",
          "options": {
            "cypressConfig": "apps/button2-e2e/cypress.json",
            "tsConfig": "apps/button2-e2e/tsconfig.e2e.json",
            "devServerTarget": "button2:storybook"
          },
          "configurations": {
            "ci": {
              "devServerTarget": "button2:storybook:ci"
            }
          }
        },
        "lint": {
          "executor": "@nrwl/linter:eslint",
          "options": {
            "lintFilePatterns": ["apps/button2-e2e/**/*.{js,ts}"]
          }
        }
      }
    },
